    "To add someone, name a speaker in any note and keep “Remember this voice” on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add someone, name a speaker in any note and keep “Remember this voice” on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir a alguien, pon nombre a un hablante en cualquier nota y deja activado “Recordar esta voz”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter quelqu’un, nommez un intervenant dans une note et laissez « Mémoriser cette voix » activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere qualcuno, dai un nome a una voce in una nota e lascia attivo “Ricorda questa voce”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, nomeie um locutor em qualquer nota e mantenha “Lembrar esta voz” ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um orador numa nota e mantenha «Memorizar esta voz» ativado."
          }
        }
      }
    },
