    "A name applies to every passage of that speaker. Check suggested and automatic names before relying on them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name applies to every passage of that speaker. Check suggested and automatic names before relying on them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre se aplica a todos los fragmentos de ese hablante. Revisa los nombres sugeridos y automáticos antes de fiarte de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom s’applique à tous les passages de cet intervenant. Vérifiez les noms suggérés et automatiques avant de vous y fier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome vale per ogni passaggio di quella voce. Controlla i nomi suggeriti e automatici prima di fidarti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome vale para todos os trechos desse locutor. Confira os nomes sugeridos e automáticos antes de confiar neles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome aplica-se a todos os trechos desse orador. Verifique os nomes sugeridos e automáticos antes de confiar neles."
          }
        }
      }
    },
