    "They were made by a newer Cassini or are damaged. Nothing was changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They were made by a newer Cassini or are damaged. Nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las creó una versión más reciente de Cassini o están dañadas. No se cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles ont été créées par une version plus récente de Cassini ou sont endommagées. Rien n’a été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state create da una versione più recente di Cassini o sono danneggiate. Non è stato modificato nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas foram criadas por uma versão mais recente do Cassini ou estão danificadas. Nada foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram criadas por uma versão mais recente do Cassini ou estão danificadas. Nada foi alterado."
          }
        }
      }
    },
    "This adds a new version. You can go back to the current names in Versions.": {
      "extractionState": "manual",
