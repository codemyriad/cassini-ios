    "Speaker analysis runs on this device and may take several minutes for a long recording. Names you gave stay available in Versions when you analyze again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker analysis runs on this device and may take several minutes for a long recording. Names you gave stay available in Versions when you analyze again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de hablantes se hace en este dispositivo y puede tardar varios minutos en una grabación larga. Los nombres que pusiste siguen disponibles en Versiones cuando vuelves a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse des intervenants s’effectue sur cet appareil et peut prendre plusieurs minutes pour un long enregistrement. Les noms que vous avez donnés restent disponibles dans Versions si vous relancez l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi delle voci avviene su questo dispositivo e può richiedere alcuni minuti per una registrazione lunga. I nomi che hai dato restano disponibili in Versioni quando analizzi di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de locutores acontece neste dispositivo e pode levar vários minutos em uma gravação longa. Os nomes que você deu continuam disponíveis em Versões quando você analisa de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de oradores é feita neste dispositivo e pode demorar vários minutos numa gravação longa. Os nomes que atribuiu continuam disponíveis em Versões quando analisar novamente."
          }
        }
      }
    },
