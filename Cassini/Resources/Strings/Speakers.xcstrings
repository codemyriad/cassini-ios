    "Cassini stops recognising all %lld saved voices and deletes the voiceprints from every note. Names already in your notes stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini stops recognising %lld saved voice and deletes the voiceprints from every note. Names already in your notes stay."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini stops recognising all %lld saved voices and deletes the voiceprints from every note. Names already in your notes stay."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini dejará de reconocer las %lld voces guardadas y eliminará las huellas de voz de todas las notas. Los nombres que ya están en tus notas se mantienen."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini dejará de reconocer %lld voz guardada y eliminará las huellas de voz de todas las notas. Los nombres que ya están en tus notas se mantienen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini dejará de reconocer las %lld voces guardadas y eliminará las huellas de voz de todas las notas. Los nombres que ya están en tus notas se mantienen."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini cesse de reconnaître les %lld voix mémorisées et supprime les empreintes vocales de toutes les notes. Les noms déjà présents dans vos notes sont conservés."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini cesse de reconnaître %lld voix mémorisée et supprime les empreintes vocales de toutes les notes. Les noms déjà présents dans vos notes sont conservés."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini cesse de reconnaître les %lld voix mémorisées et supprime les empreintes vocales de toutes les notes. Les noms déjà présents dans vos notes sont conservés."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini smette di riconoscere %lld voce salvata ed elimina le impronte vocali da ogni nota. I nomi già presenti nelle note restano."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini smette di riconoscere tutte le %lld voci salvate ed elimina le impronte vocali da ogni nota. I nomi già presenti nelle note restano."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cassini smette di riconoscere tutte le %lld voci salvate ed elimina le impronte vocali da ogni nota. I nomi già presenti nelle note restano."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Cassini deixa de reconhecer todas as %lld vozes salvas e exclui as impressões de voz de todas as notas. Os nomes que já estão nas suas notas permanecem."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Cassini deixa de reconhecer %lld voz salva e exclui as impressões de voz de todas as notas. Os nomes que já estão nas suas notas permanecem."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Cassini deixa de reconhecer todas as %lld vozes salvas e exclui as impressões de voz de todas as notas. Os nomes que já estão nas suas notas permanecem."
                }
              }
            }
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Cassini deixa de reconhecer todas as %lld vozes guardadas e elimina as impressões vocais de todas as notas. Os nomes já presentes nas notas mantêm-se."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
