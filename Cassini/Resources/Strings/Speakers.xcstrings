    "Voiceprints stay on this device. They are never uploaded or written into shared files — only the names you choose are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints stay on this device. They are never uploaded or written into shared files — only the names you choose are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las huellas de voz se quedan en este dispositivo. Nunca se suben ni se escriben en archivos compartidos — solo los nombres que eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes vocales restent sur cet appareil. Elles ne sont jamais envoyées ni écrites dans les fichiers partagés — seuls les noms que vous choisissez le sont."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impronte vocali restano su questo dispositivo. Non vengono mai caricate né scritte nei file condivisi — solo i nomi che scegli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões de voz ficam neste dispositivo. Elas nunca são enviadas nem incluídas em arquivos compartilhados — só os nomes que você escolhe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões vocais ficam neste dispositivo. Nunca são enviadas nem escritas em ficheiros partilhados — só os nomes que escolher."
          }
        }
      }
    },
