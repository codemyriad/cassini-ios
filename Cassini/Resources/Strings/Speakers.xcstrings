    "Saved voices can’t be changed now, so this voice can’t be remembered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices can’t be changed now, so this voice can’t be remembered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se pueden modificar las voces guardadas, así que no se puede recordar esta voz."
