    "This iPad is low on memory. Close other apps if transcription stops.": {
      "comment": "The memory hint on the processing card of an iPad",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad tiene poca memoria. Cierra otras apps si la transcripción se detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPad manque de mémoire. Fermez d’autres apps si la transcription s’arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPad ha poca memoria. Chiudi altre app se la trascrizione si ferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad está com pouca memória. Feche outros apps se a transcrição parar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad tem pouca memória. Feche outras aplicações se a transcrição parar."
          }
        }
      }
    },
    "This phone is low on memory. Close other apps if transcription stops.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono tiene poca memoria. Cierra otras apps si la transcripción se detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone manque de mémoire. Fermez d’autres apps si la transcription s’arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono ha poca memoria. Chiudi altre app se la trascrizione si ferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular está com pouca memória. Feche outros apps se a transcrição parar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telemóvel tem pouca memória. Feche outras aplicações se a transcrição parar."
          }
        }
      }
    },
    "Transcription runs on this device. If iOS stops it in the background, your progress is kept.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se hace en este dispositivo. Si iOS la detiene en segundo plano, tu progreso se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription s’effectue sur cet appareil. Si iOS l’interrompt en arrière-plan, votre progression est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione avviene su questo dispositivo. Se iOS la ferma in background, i progressi restano salvati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição acontece neste dispositivo. Se o iOS interrompê-la em segundo plano, seu progresso é mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição é feita neste dispositivo. Se o iOS a parar em segundo plano, o progresso é mantido."
          }
        }
      }
    },
