{
  "sourceLanguage": "en",
  "strings": {
    "Apple’s on-device speech model does not support this language. Choose another language in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’s on-device speech model does not support this language. Choose another language in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de voz de Apple en el dispositivo no admite este idioma. Elige otro idioma en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle vocal d’Apple sur l’appareil ne prend pas en charge cette langue. Choisissez une autre langue dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello vocale di Apple sul dispositivo non supporta questa lingua. Scegli un’altra lingua in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de fala da Apple neste dispositivo não é compatível com este idioma. Escolha outro idioma em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de voz da Apple no dispositivo não suporta este idioma. Escolha outro idioma nas Definições."
          }
        }
      }
    },
    "Audio decoding stalled. Try another file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio decoding stalled. Try another file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La decodificación del audio se detuvo. Prueba con otro archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décodage de l’audio s’est bloqué. Essayez un autre fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lettura dell’audio si è bloccata. Prova un altro file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A decodificação do áudio travou. Tente outro arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura do áudio bloqueou. Experimente outro ficheiro."
          }
        }
      }
    },
    "Choose at least 200 milliseconds of audio.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos 200 milisegundos de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins 200 millisecondes d’audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno 200 millisecondi di audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pelo menos 200 milissegundos de áudio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pelo menos 200 milissegundos de áudio."
          }
        }
      }
    },
    "Could not read this audio. The original file has been kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read this audio. The original file has been kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este audio. Se conservó el archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet audio. Le fichier d’origine a été conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’audio. Il file originale è stato conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este áudio. O arquivo original foi mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este áudio. O ficheiro original foi mantido."
          }
        }
      }
    },
    "Could not save changes: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los cambios: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder les modifications : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le modifiche: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as alterações: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar as alterações: %@"
          }
        }
      }
    },
    "Could not save the model. Free some space and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the model. Free some space and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el modelo. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder le modèle. Libérez de l’espace et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il modello. Libera spazio e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o modelo. Libere espaço e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o modelo. Liberte espaço e tente novamente."
          }
        }
      }
    },
    "Model download failed. Check your connection and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model download failed. Check your connection and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement du modèle. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download non riuscito. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no download do modelo. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na transferência do modelo. Verifique a ligação e tente novamente."
          }
        }
      }
    },
    "Model verification failed. Please download it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model verification failed. Please download it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el modelo. Descárgalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la vérification du modèle. Téléchargez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica del modello non riuscita. Scaricalo di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação do modelo. Baixe-o de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação do modelo. Transfira-o novamente."
          }
        }
      }
    },
    "No speakers were detected. You can assign passages manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speakers were detected. You can assign passages manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron hablantes. Puedes asignar los fragmentos manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun intervenant n’a été détecté. Vous pouvez attribuer les passages manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono state rilevate voci. Puoi assegnare i passaggi a mano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum locutor foi detectado. Você pode atribuir os trechos manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram detetados oradores. Pode atribuir os trechos manualmente."
          }
        }
      }
    },
    "Not enough memory. Try a shorter clip and close other apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough memory. Try a shorter clip and close other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insuficiente. Prueba con un clip más corto y cierra otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire insuffisante. Essayez un extrait plus court et fermez les autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insufficiente. Prova una clip più breve e chiudi altre app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória insuficiente. Tente um clipe mais curto e feche outros apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória insuficiente. Experimente um excerto mais curto e feche outras aplicações."
          }
        }
      }
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {
        "es": {
