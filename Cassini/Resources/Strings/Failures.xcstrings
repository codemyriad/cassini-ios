    "This recording is too long to transcribe: one transcript holds up to 36 hours of audio and about 16 hours of speech. You can still play it, and share the audio file with Share original audio.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación es demasiado larga para transcribirla: una transcripción admite hasta 36 horas de audio y unas 16 horas de habla. Aún puedes reproducirla y compartir el archivo de audio con Compartir audio original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement est trop long pour être transcrit : une transcription contient au maximum 36 heures d’audio et environ 16 heures de parole. Vous pouvez toujours l’écouter, et partager le fichier audio avec Partager l’audio d’origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione è troppo lunga da trascrivere: una trascrizione contiene fino a 36 ore di audio e circa 16 ore di parlato. Puoi comunque ascoltarla e condividere il file audio con Condividi l’audio originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação é longa demais para transcrever: uma transcrição comporta até 36 horas de áudio e cerca de 16 horas de fala. Você ainda pode reproduzi-la e compartilhar o arquivo de áudio com Compartilhar áudio original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação é demasiado longa para transcrever: uma transcrição comporta até 36 horas de áudio e cerca de 16 horas de fala. Pode ainda reproduzi-la e partilhar o ficheiro de áudio com Partilhar áudio original."
          }
        }
      }
    },
