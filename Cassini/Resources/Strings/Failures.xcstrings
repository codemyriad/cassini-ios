            "value": "Operação cancelada."
          }
        }
      }
    },
    "Playback is unavailable for this file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback is unavailable for this file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción no está disponible para este archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture impossible pour ce fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduzione non disponibile per questo file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução não está disponível para este arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução não está disponível para este ficheiro."
          }
        }
      }
    },
    "Saved progress no longer matches the audio. Start over to transcribe it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved progress no longer matches the audio. Start over to transcribe it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso guardado ya no coincide con el audio. Empieza de nuevo para volver a transcribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression sauvegardée ne correspond plus à l’audio. Recommencez pour le transcrire à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi salvati non corrispondono più all’audio. Ricomincia per trascriverlo di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso salvo não corresponde mais ao áudio. Recomece para transcrevê-lo de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso guardado já não corresponde ao áudio. Recomece para o transcrever novamente."
          }
        }
      }
    },
    "Something needs attention": {
      "comment": "Title of an app-wide error alert",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo requiere atención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point est à vérifier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa richiede attenzione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo precisa de atenção"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo requer atenção"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non ha funzionato. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal. Tente novamente."
          }
        }
      }
    },
    "Speaker analysis could not finish. Your transcript is saved. You can retry from Speakers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker analysis could not finish. Your transcript is saved. You can retry from Speakers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de hablantes no pudo terminar. Tu transcripción está guardada. Puedes volver a intentarlo desde Hablantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse des intervenants n’a pas pu aboutir. Votre transcription est sauvegardée. Vous pouvez réessayer depuis Intervenants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi delle voci non è terminata. La trascrizione è salvata. Puoi riprovare da Voci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a análise de locutores. Sua transcrição está salva. Você pode tentar novamente em Locutores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a análise de oradores. A transcrição está guardada. Pode tentar novamente em Oradores."
          }
        }
      }
    },
    "The audio of this document could not be checked, so a new version cannot be added.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio of this document could not be checked, so a new version cannot be added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el audio de este documento, así que no se puede añadir una nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de ce document n’a pas pu être vérifié, donc aucune nouvelle version ne peut être ajoutée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’audio di questo documento, quindi non si può aggiungere una nuova versione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o áudio deste documento, então não é possível adicionar uma nova versão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o áudio deste documento, por isso não é possível adicionar uma nova versão."
          }
        }
      }
    },
    "The system cannot reserve another speech language. Try a language already installed on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system cannot reserve another speech language. Try a language already installed on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema no puede reservar otro idioma de voz. Prueba con un idioma ya instalado en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système ne peut pas réserver une autre langue parlée. Essayez une langue déjà installée sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema non può riservare un’altra lingua vocale. Prova una lingua già installata su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema não pode reservar outro idioma de fala. Tente um idioma já instalado neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema não consegue reservar outro idioma de fala. Experimente um idioma já instalado neste dispositivo."
          }
        }
      }
    },
    "The transcript could not be saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la transcripción."
          }
