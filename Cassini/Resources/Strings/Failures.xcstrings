            "state": "translated",
            "value": "OK"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "On-device transcription is unavailable on this device. Your audio can still be played or exported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device transcription is unavailable on this device. Your audio can still be played or exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción no está disponible en este dispositivo. Aún puedes reproducir o exportar el audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription n’est pas disponible sur cet appareil. Vous pouvez toujours écouter ou exporter l’audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione non è disponibile su questo dispositivo. Puoi comunque ascoltare o esportare l’audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição não está disponível neste dispositivo. Você ainda pode reproduzir ou exportar o áudio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição não está disponível neste dispositivo. O áudio ainda pode ser reproduzido ou exportado."
          }
        }
      }
    },
    "Open settings": {
      "comment": "Opens this app's page in Settings",
      "extractionState": "manual",
      "localizations": {
        "es": {
