    "settings.transfer.exportHint": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, settings.transfer.exportHint.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep a copy somewhere safe, use Export All as ZIP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conservare una copia in un posto sicuro, usa “Esporta tutto come ZIP”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour garder une copie en lieu sûr, utilisez « Tout exporter en ZIP »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar una copia en un lugar seguro, usa “Exportar todo como ZIP”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar uma cópia em um lugar seguro, use “Exportar tudo como ZIP”."
