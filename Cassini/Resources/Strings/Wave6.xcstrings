    "backup.info.manualCopy.heading": {
      "comment": "Generated from cassini-ux 60ac93da94ce433412c93d8e96a76c68503dcec3, backup.info.manualCopy.heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy you keep yourself"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia che conservi tu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie que vous gardez vous-même"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia que guardas tú"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia que você mesmo guarda"
          }
