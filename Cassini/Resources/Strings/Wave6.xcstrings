    "voices.setup.privacy.phone": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, voices.setup.privacy.phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints are created on this phone and are never written into exported or shared files. You can choose in Settings whether backups include them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impronte vocali vengono create su questo telefono e non vengono mai scritte nei file esportati o condivisi. Nelle impostazioni puoi scegliere se includerle nei backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes vocales sont créées sur ce téléphone et ne sont jamais écrites dans les fichiers exportés ou partagés. Vous pouvez choisir dans les réglages si les sauvegardes les incluent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las huellas de voz se crean en este teléfono y nunca se incluyen en los archivos exportados o compartidos. En Ajustes puedes elegir si se incluyen en las copias de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões de voz são criadas neste celular e nunca são incluídas em arquivos exportados ou compartilhados. Nos Ajustes, você pode escolher se elas entram nos backups."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões vocais são criadas neste telemóvel e nunca são incluídas nos ficheiros exportados ou partilhados. Nas definições, pode escolher se são incluídas nas cópias de segurança."
          }
        }
      }
    },
