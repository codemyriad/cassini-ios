{
  "sourceLanguage": "en",
  "strings": {
    "backup.cloud.body.off.ios": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.cloud.body.off.ios.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings are marked to be left out of iCloud Backup, and Cassini never uploads them. A direct transfer to a new iPhone or iPad may still copy them. Turning this off does not delete backups already stored in iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni sono contrassegnate per essere escluse dal Backup iCloud e Cassini non le carica mai. Un trasferimento diretto a un nuovo iPhone o iPad potrebbe comunque copiarle. Disattivare questa opzione non elimina i backup già salvati in iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions sont marquées pour être exclues de la Sauvegarde iCloud, et Cassini ne les met jamais en ligne. Un transfert direct vers un nouvel iPhone ou iPad peut tout de même les copier. Désactiver cette option ne supprime pas les sauvegardes déjà stockées dans iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones se marcan para quedar fuera de Copia en iCloud, y Cassini nunca las sube. Una transferencia directa a un iPhone o iPad nuevo podría copiarlas igualmente. Desactivar esta opción no elimina las copias ya guardadas en iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões são marcadas para ficar fora do Backup do iCloud, e o Cassini nunca as envia. Uma transferência direta para um novo iPhone ou iPad ainda pode copiá-las. Desativar esta opção não exclui os backups já guardados no iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões são marcadas para ficar fora da Cópia em iCloud, e o Cassini nunca as envia. Uma transferência direta para um iPhone ou iPad novo pode ainda assim copiá-las. Desativar esta opção não elimina as cópias de segurança já guardadas em iCloud."
          }
        }
      }
    },
    "backup.cloud.body.on": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.cloud.body.on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetings are included in your phone’s backups and when you move to a new phone. Downloaded speech models are not backed up; a new phone downloads them again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le riunioni sono incluse nei backup del telefono e vengono copiate quando passi a un nuovo telefono. I modelli vocali scaricati non sono inclusi nel backup: il nuovo telefono li scarica di nuovo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réunions sont incluses dans les sauvegardes de votre téléphone et transférées lorsque vous passez à un nouveau téléphone. Les modèles vocaux téléchargés ne sont pas sauvegardés ; le nouveau téléphone les télécharge à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones se incluyen en las copias de seguridad de tu teléfono y al cambiar a un teléfono nuevo. Los modelos de voz descargados no se copian; el teléfono nuevo los descarga otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões são incluídas nos backups do seu celular e quando você muda para um novo celular. Os modelos de voz baixados não entram no backup; o novo celular os baixa novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As reuniões são incluídas nas cópias de segurança do seu telemóvel e ao mudar para um telemóvel novo. Os modelos de voz transferidos não entram na cópia de segurança; o telemóvel novo volta a transferi-los."
          }
        }
      }
    },
    "backup.cloud.title": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.cloud.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted cloud backup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup crittografato nel cloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde cloud chiffrée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de seguridad cifrada en la nube"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup criptografado na nuvem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópia de segurança encriptada na nuvem"
          }
        }
      }
    },
    "backup.includeSavedVoices.subtitle.ios": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.includeSavedVoices.subtitle.ios.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices are on-device voiceprints of people you have named, so a new or restored iPhone or iPad keeps recognising them automatically. Turn this off to leave voiceprints out of iCloud Backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci salvate sono impronte vocali create sul dispositivo per le persone a cui hai dato un nome, così un iPhone o iPad nuovo o ripristinato continua a riconoscerle automaticamente. Disattiva questa opzione per escludere le impronte vocali dal Backup iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix mémorisées sont les empreintes vocales créées sur l’appareil pour les personnes que vous avez nommées, afin qu’un iPhone ou iPad neuf ou restauré continue à les reconnaître automatiquement. Désactivez cette option pour exclure les empreintes vocales de la Sauvegarde iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las voces guardadas son huellas de voz creadas en el dispositivo para las personas a las que has puesto nombre, de modo que un iPhone o iPad nuevo o restaurado siga reconociéndolas automáticamente. Desactívalo para dejar las huellas de voz fuera de Copia en iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes salvas são impressões de voz criadas no aparelho para as pessoas que você nomeou, para que um iPhone ou iPad novo ou restaurado continue reconhecendo cada uma automaticamente. Desative esta opção para deixar as impressões de voz fora do Backup do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes guardadas são impressões vocais criadas no dispositivo para as pessoas a quem deu nome, para que um iPhone ou iPad novo ou restaurado continue a reconhecê-las automaticamente. Desative esta opção para deixar as impressões vocais fora da Cópia em iCloud."
          }
        }
      }
    },
    "backup.includeSavedVoices.subtitle.off.ios": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.includeSavedVoices.subtitle.off.ios.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices are marked to be left out of iCloud Backup. A direct transfer to a new iPhone or iPad may still copy them. After restoring from iCloud Backup, you will need to name speakers again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci salvate sono contrassegnate per essere escluse dal Backup iCloud. Un trasferimento diretto a un nuovo iPhone o iPad potrebbe comunque copiarle. Dopo un ripristino dal Backup iCloud dovrai dare di nuovo un nome alle voci."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix mémorisées sont marquées pour être exclues de la Sauvegarde iCloud. Un transfert direct vers un nouvel iPhone ou iPad peut tout de même les copier. Après une restauration depuis la Sauvegarde iCloud, vous devrez nommer à nouveau les intervenants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las voces guardadas se marcan para quedar fuera de Copia en iCloud. Una transferencia directa a un iPhone o iPad nuevo podría copiarlas igualmente. Tras restaurar desde Copia en iCloud, tendrás que volver a poner nombre a los hablantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes salvas são marcadas para ficar fora do Backup do iCloud. Uma transferência direta para um novo iPhone ou iPad ainda pode copiá-las. Depois de restaurar a partir do Backup do iCloud, você precisará nomear os locutores novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes guardadas são marcadas para ficar fora da Cópia em iCloud. Uma transferência direta para um iPhone ou iPad novo pode ainda assim copiá-las. Depois de restaurar a partir da Cópia em iCloud, terá de dar novamente nome aos oradores."
          }
        }
      }
    },
    "backup.includeSavedVoices.title": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.includeSavedVoices.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include saved voices in backups"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi le voci salvate nei backup"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure les voix mémorisées dans les sauvegardes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir las voces guardadas en las copias de seguridad"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir as vozes salvas nos backups"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir as vozes guardadas nas cópias de segurança"
          }
        }
      }
    },
    "backup.info.icloud.body": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.info.icloud.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud Backup is on, backups are stored in your iCloud account. Apple can read an iCloud backup unless you turn on Advanced Data Protection in your Apple Account settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il Backup iCloud è attivo, i backup vengono archiviati nel tuo account iCloud. Apple può leggere un backup iCloud a meno che tu non attivi la Protezione avanzata dei dati nelle impostazioni del tuo Account Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la Sauvegarde iCloud est activée, les sauvegardes sont stockées dans votre compte iCloud. Apple peut lire une sauvegarde iCloud, sauf si vous activez la Protection avancée des données dans les réglages de votre compte Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Copia en iCloud está activada, las copias se guardan en tu cuenta de iCloud. Apple puede leer una copia en iCloud a menos que actives Protección avanzada de datos en los ajustes de tu cuenta de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Backup do iCloud estiver ativado, os backups são armazenados na sua conta do iCloud. A Apple pode ler um backup do iCloud, a menos que você ative a Proteção Avançada de Dados nos ajustes da sua Conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a Cópia em iCloud estiver ativa, as cópias de segurança são guardadas na sua conta iCloud. A Apple pode ler uma cópia em iCloud, a menos que ative a Proteção avançada de dados nas definições da sua Conta Apple."
          }
        }
      }
    },
    "backup.info.icloud.computerBody": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.info.icloud.computerBody.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup made on your computer is readable by anyone who can use that computer unless you set a backup password."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un backup effettuato sul tuo computer può essere letto da chiunque usi quel computer, a meno che tu non imposti una password per il backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde effectuée sur votre ordinateur peut être lue par toute personne ayant accès à cet ordinateur, sauf si vous définissez un mot de passe de sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier persona que pueda usar tu equipo puede leer una copia hecha en él, salvo que configures una contraseña para la copia de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup feito no seu computador pode ser lido por qualquer pessoa que use esse computador, a menos que você defina uma senha para o backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia de segurança feita no seu computador pode ser lida por qualquer pessoa que utilize esse computador, a menos que defina uma palavra-passe para a cópia."
          }
        }
      }
    },
