    "backup.info.what.body": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.info.what.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meetings, transcripts and speaker names are backed up while backup is on. Saved voices are included while “Include saved voices in backups” is on. Downloaded speech models are never backed up; your new phone downloads them again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue riunioni, le trascrizioni e i nomi delle voci sono inclusi finché il backup è attivo. Le voci salvate sono incluse finché “Includi le voci salvate nei backup” è attivo. I modelli vocali scaricati non vengono mai inclusi: il nuovo telefono li scarica di nuovo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions, leurs transcriptions et les noms des intervenants sont sauvegardés tant que la sauvegarde est activée. Les voix mémorisées sont incluses tant que « Inclure les voix mémorisées dans les sauvegardes » est activé. Les modèles vocaux téléchargés ne sont jamais sauvegardés ; votre nouveau téléphone les télécharge à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones, transcripciones y nombres de hablantes se guardan en la copia de seguridad mientras está activa. Las voces guardadas se incluyen mientras “Incluir las voces guardadas en las copias de seguridad” está activo. Los modelos de voz descargados nunca se copian; tu teléfono nuevo los descarga otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões, transcrições e nomes de locutores entram no backup enquanto ele estiver ativado. As vozes salvas são incluídas enquanto “Incluir as vozes salvas nos backups” estiver ativado. Os modelos de voz baixados nunca entram no backup; o seu novo celular os baixa novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas reuniões, transcrições e nomes de oradores são incluídos enquanto a cópia de segurança estiver ativa. As vozes guardadas são incluídas enquanto «Incluir as vozes guardadas nas cópias de segurança» estiver ativo. Os modelos de voz transferidos nunca são incluídos; o seu telemóvel novo volta a transferi-los."
          }
        }
      }
    },
    "backup.info.what.heading": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.info.what.heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
