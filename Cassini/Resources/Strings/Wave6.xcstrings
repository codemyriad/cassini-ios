    "voices.setup.body": {
      "comment": "Generated from cassini-ux 60ac93da94ce433412c93d8e96a76c68503dcec3, voices.setup.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you name a speaker in a meeting, Cassini can remember their voice and name them automatically in future meetings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai un nome a una voce in una riunione, Cassini può ricordarla e darle il nome automaticamente nelle prossime riunioni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous nommez un intervenant dans une réunion, Cassini peut mémoriser sa voix et le nommer automatiquement dans les prochaines réunions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pones nombre a un hablante en una reunión, Cassini puede recordar su voz y ponerle nombre automáticamente en las próximas reuniones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você dá nome a um locutor em uma reunião, o Cassini pode lembrar a voz dele e nomeá-lo automaticamente nas próximas reuniões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dá nome a um orador numa reunião, o Cassini pode memorizar essa voz e dar-lhe o nome automaticamente nas próximas reuniões."
          }
        }
      }
    },
