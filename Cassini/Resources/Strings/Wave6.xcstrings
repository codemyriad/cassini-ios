    "voices.enroll.fromTranscriptHint": {
      "comment": "Generated from cassini-ux 60ac93da94ce433412c93d8e96a76c68503dcec3, voices.enroll.fromTranscriptHint.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also save a voice from any meeting by naming a speaker and keeping “Remember this voice” on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche salvare una voce da qualsiasi riunione dando un nome a una voce e lasciando attivo “Ricorda questa voce”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi mémoriser une voix depuis n’importe quelle réunion en nommant un intervenant et en laissant « Mémoriser cette voix » activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes guardar una voz desde cualquier reunión poniendo nombre a un hablante y dejando activado “Recordar esta voz”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode salvar uma voz a partir de qualquer reunião dando nome a um locutor e deixando “Lembrar esta voz” ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode guardar uma voz a partir de qualquer reunião dando nome a um orador e deixando «Memorizar esta voz» ativado."
          }
        }
      }
    },
    "voices.enroll.instructions": {
      "comment": "Generated from cassini-ux 60ac93da94ce433412c93d8e96a76c68503dcec3, voices.enroll.instructions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the person’s name, then ask them to read the phrase below in their normal speaking voice."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il nome della persona, poi chiedile di leggere la frase qui sotto con il suo tono di voce abituale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom de la personne, puis demandez-lui de lire la phrase ci-dessous d’une voix naturelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el nombre de la persona y pídele que lea en voz alta la frase de abajo con su voz habitual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o nome da pessoa e peça que ela leia a frase abaixo com seu tom de voz normal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o nome da pessoa e peça-lhe para ler a frase abaixo no seu tom de voz habitual."
          }
        }
      }
    },
