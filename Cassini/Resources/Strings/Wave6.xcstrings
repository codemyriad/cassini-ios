    "backup.phoneOnlyCard.body": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, backup.phoneOnlyCard.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meetings and saved voices are included in encrypted cloud backup and copied when you move to a new phone, so you don’t lose them if this phone is lost or replaced."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue riunioni e le voci salvate sono incluse nel backup crittografato nel cloud e vengono copiate quando passi a un nuovo telefono, così non le perdi se questo telefono viene perso o sostituito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions et vos voix mémorisées sont incluses dans la sauvegarde cloud chiffrée et copiées lorsque vous passez à un nouveau téléphone, afin de ne pas les perdre si ce téléphone est perdu ou remplacé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones y voces guardadas se incluyen en la copia de seguridad cifrada en la nube y se copian al cambiar a un teléfono nuevo, para que no las pierdas si pierdes o cambias este teléfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões e vozes salvas são incluídas no backup criptografado na nuvem e copiadas quando você muda para um novo celular, para que você não as perca se este celular for perdido ou substituído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas reuniões e vozes guardadas são incluídas na cópia de segurança encriptada na nuvem e copiadas ao mudar para um telemóvel novo, para que não as perca se este telemóvel for perdido ou substituído."
          }
        }
      }
    },
