    "voices.enroll.testPhrase": {
      "comment": "Generated from cassini-ux dd06a62dc881034fed417b000f47004e577a3fb0, voices.enroll.testPhrase.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello, I’m speaking at my usual pace so Cassini can recognise my voice in future meetings and write my name next to what I say."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao, sto parlando con il mio ritmo abituale così Cassini potrà riconoscere la mia voce nelle prossime riunioni e scrivere il mio nome accanto a quello che dico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, je parle à mon rythme habituel pour que Cassini puisse reconnaître ma voix lors des prochaines réunions et écrire mon nom à côté de ce que je dis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, estoy hablando a mi ritmo habitual para que Cassini pueda reconocer mi voz en las próximas reuniones y escribir mi nombre junto a lo que digo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, estou falando no meu ritmo normal para que o Cassini possa reconhecer a minha voz nas próximas reuniões e escrever o meu nome ao lado do que eu disser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, estou a falar ao meu ritmo habitual para que o Cassini possa reconhecer a minha voz nas próximas reuniões e escrever o meu nome ao lado do que eu disser."
          }
        }
      }
    },
