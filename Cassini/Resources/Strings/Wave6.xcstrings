            "value": "Ce qui est sauvegardé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se incluye en la copia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
