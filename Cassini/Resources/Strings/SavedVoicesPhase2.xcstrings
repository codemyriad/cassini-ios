{
  "sourceLanguage": "en",
  "strings": {
    "confirm.deleteVoiceProfile.body": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, confirm.deleteVoiceProfile.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini will no longer recognise {name} in new meetings. Names already in transcripts stay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini non riconoscerà più {name} nelle nuove riunioni. I nomi già presenti nelle trascrizioni restano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ne reconnaîtra plus {name} dans les nouvelles réunions. Les noms déjà présents dans les transcriptions sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ya no reconocerá a {name} en las reuniones nuevas. Los nombres que ya están en las transcripciones se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini não vai mais reconhecer {name} em novas reuniões. Os nomes que já estão nas transcrições são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini deixa de reconhecer {name} em novas reuniões. Os nomes que já estão nas transcrições mantêm-se."
          }
        }
      }
    },
    "confirm.deleteVoiceProfile.primary": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, confirm.deleteVoiceProfile.primary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer"
          }
        }
      }
    },
    "confirm.deleteVoiceProfile.title": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, confirm.deleteVoiceProfile.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget {name}’s voice?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimenticare la voce di {name}?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier la voix de {name} ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidar la voz de {name}?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer a voz de {name}?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer a voz de {name}?"
          }
        }
      }
    },
    "savedVoices.addVoice": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.addVoice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a voice"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una voce"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une voix"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una voz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma voz"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma voz"
          }
        }
      }
    },
    "savedVoices.caption": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add someone, name a speaker in a meeting and keep “Remember this voice” on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere qualcuno, dai un nome a una persona in una riunione e lascia attivo “Ricorda questa voce”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter quelqu’un, nommez un intervenant dans une réunion et laissez « Mémoriser cette voix » activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir a alguien, pon nombre a un hablante en una reunión y deja activado «Recordar esta voz»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, nomeie um falante em uma reunião e deixe “Lembrar esta voz” ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um orador numa reunião e deixe “Memorizar esta voz” ativado."
          }
        }
      }
    },
    "savedVoices.empty": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved voices yet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna voce salvata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix mémorisée pour l’instant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay voces guardadas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma voz salva ainda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há vozes guardadas"
          }
        }
      }
    },
    "savedVoices.empty.body": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.empty.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a speaker in a meeting and keep “Remember this voice” on. Next time, Cassini names them for you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome a una persona in una riunione e lascia attivo “Ricorda questa voce”. La prossima volta, Cassini le darà il nome per te."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez un intervenant dans une réunion et laissez « Mémoriser cette voix » activé. La prochaine fois, Cassini le nommera pour vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon nombre a un hablante en una reunión y deja activado «Recordar esta voz». La próxima vez, Cassini le pondrá el nombre por ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomeie um falante em uma reunião e deixe “Lembrar esta voz” ativado. Da próxima vez, o Cassini o nomeia para você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê nome a um orador numa reunião e deixe “Memorizar esta voz” ativado. Da próxima vez, o Cassini dá-lhe o nome por si."
          }
        }
      }
    },
    "savedVoices.footnote.madeOn.ipad": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.footnote.madeOn.ipad.",
      "extractionState": "manual",
      "localizations": {
