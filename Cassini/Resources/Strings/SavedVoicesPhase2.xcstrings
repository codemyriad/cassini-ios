{
  "sourceLanguage": "en",
  "strings": {
    "savedVoices.howToAdd": {
      "comment": "Generated from cassini-ux 160fb923944422c5c4ff01aa777bb572e2a6e96e, savedVoices.howToAdd.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add someone, name a speaker in any meeting and keep “Remember this voice” on. After you forget a voice, the names already in your meetings stay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere qualcuno, dai un nome a una voce in una riunione e lascia attivo “Ricorda questa voce”. Se dimentichi una voce, i nomi già presenti nelle tue riunioni restano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter quelqu’un, nommez un intervenant dans n’importe quelle réunion et laissez « Mémoriser cette voix » activé. Une fois une voix oubliée, les noms déjà présents dans vos réunions sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir a alguien, pon nombre a un hablante en cualquier reunión y deja activado “Recordar esta voz”. Si olvidas una voz, los nombres que ya están en tus reuniones se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um locutor em qualquer reunião e deixe “Lembrar esta voz” ativado. Se você esquecer uma voz, os nomes que já estão nas suas reuniões são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um orador em qualquer reunião e deixe «Memorizar esta voz» ativado. Depois de esquecer uma voz, os nomes que já estão nas suas reuniões mantêm-se."
          }
        }
      }
    },
