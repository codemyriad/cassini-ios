    "savedVoices.row.stale": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.row.stale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name them again in a meeting to keep recognising them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai di nuovo un nome a questa voce in una riunione, così Cassini continuerà a riconoscerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez à nouveau cette personne dans une réunion pour que Cassini continue à la reconnaître."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner nombre a esta persona en una reunión para que Cassini la siga reconociendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomeie essa pessoa de novo em uma reunião para que ela continue sendo reconhecida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê novamente nome a esta pessoa numa reunião para que continue a ser reconhecida."
          }
        }
      }
    },
    "savedVoices.stale.body": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.stale.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice recognition was updated, and voices saved before the update can’t be recognised. Name {name} in a meeting to save their voice again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è stato aggiornato e le voci salvate prima dell’aggiornamento non possono essere riconosciute. Dai un nome a {name} in una riunione per salvare di nuovo la sua voce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale a été mise à jour, et les voix mémorisées avant la mise à jour ne peuvent plus être reconnues. Nommez {name} dans une réunion pour mémoriser à nouveau sa voix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz se ha actualizado y las voces guardadas antes de la actualización no se pueden reconocer. Pon nombre a {name} en una reunión para volver a guardar su voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de voz foi atualizado, e as vozes salvas antes da atualização não podem ser reconhecidas. Nomeie {name} em uma reunião para salvar a voz de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de voz foi atualizado, e as vozes guardadas antes da atualização não podem ser reconhecidas. Dê nome a {name} numa reunião para guardar a voz de novo."
          }
        }
      }
    },
    "savedVoices.stale.title": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.stale.title.",
