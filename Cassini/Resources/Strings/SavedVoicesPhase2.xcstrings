          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints are made on this iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impronte vocali vengono create su questo iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes vocales sont créées sur cet iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las huellas de voz se crean en este iPad."
          }
        },
        "pt-BR": {
