    "savedVoices.row.needsNaming": {
      "comment": "Generated from cassini-ux d9bf213a30179c395657e8d8ecd34fe2b987af1a, savedVoices.row.needsNaming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
