{
  "sourceLanguage": "en",
  "strings": {
    "Cassini can’t play this audio, so there is nothing to transcribe.": {
      "comment": "A Transcribe was refused: the audio cannot be decoded",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini can’t play this audio, so there is nothing to transcribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini no puede reproducir este audio, así que no hay nada que transcribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ne peut pas lire cet audio, donc il n’y a rien à transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini non riesce a riprodurre questo audio, quindi non c’è niente da trascrivere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini não consegue reproduzir este áudio, então não há nada para transcrever."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini não consegue reproduzir este áudio, por isso não há nada para transcrever."
          }
        }
      }
    },
    "Cassini needs a one-time download of about %@. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here.": {
      "comment": "Model download screen body with the total download, such as 531 MB",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini needs a one-time download of about %@. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini necesita una única descarga de unos %@. Después, reconoce las palabras y distingue las voces en este dispositivo, incluso sin conexión. Tu audio se queda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini a besoin d’un téléchargement unique d’environ %@. Ensuite, la reconnaissance des mots et la distinction des voix se font sur cet appareil, même hors ligne. Votre audio reste ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ha bisogno di un unico download di circa %@. Dopo, il riconoscimento delle parole e la distinzione delle voci avvengono su questo dispositivo, anche offline. Il tuo audio resta qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de um download único de cerca de %@. Depois disso, o reconhecimento de palavras e a distinção entre vozes acontecem neste dispositivo, mesmo offline. Seu áudio fica aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de uma transferência única de cerca de %@. Depois disso, o reconhecimento de palavras e a distinção de vozes acontecem neste dispositivo, mesmo sem ligação. O áudio fica aqui."
          }
        }
      }
    },
    "Cassini needs a one-time download. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here.": {
      "comment": "Model download screen body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini needs a one-time download. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini necesita una única descarga. Después, reconoce las palabras y distingue las voces en este dispositivo, incluso sin conexión. Tu audio se queda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini a besoin d’un téléchargement unique. Ensuite, la reconnaissance des mots et la distinction des voix se font sur cet appareil, même hors ligne. Votre audio reste ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ha bisogno di un unico download. Dopo, il riconoscimento delle parole e la distinzione delle voci avvengono su questo dispositivo, anche offline. Il tuo audio resta qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de um download único. Depois disso, o reconhecimento de palavras e a distinção entre vozes acontecem neste dispositivo, mesmo offline. Seu áudio fica aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de uma transferência única. Depois disso, o reconhecimento de palavras e a distinção de vozes acontecem neste dispositivo, mesmo sem ligação. O áudio fica aqui."
          }
        }
      }
    },
    "Cassini recognises speech in %@. To transcribe another language, change it in Settings › Speech language.": {
      "comment": "On the consent screen of devices that use Apple’s speech models. %@ is the speech language’s name, e.g. Italian (Italy). ‘Settings › Speech language’ names the screen and the setting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini recognises speech in %@. To transcribe another language, change it in Settings › Speech language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma que reconoce Cassini: %@. Para transcribir otro idioma, cámbialo en Ajustes › Idioma hablado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue reconnue par Cassini : %@. Pour transcrire une autre langue, modifiez-la dans Réglages › Langue parlée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingua riconosciuta da Cassini: %@. Per trascrivere un’altra lingua, cambiala in Impostazioni › Lingua del parlato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma reconhecido pelo Cassini: %@. Para transcrever outro idioma, altere-o em Ajustes › Idioma da fala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma reconhecido pelo Cassini: %@. Para transcrever outro idioma, altere-o em Definições › Idioma da fala."
          }
        }
      }
    },
