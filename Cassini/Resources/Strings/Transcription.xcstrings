{
  "sourceLanguage": "en",
  "strings": {
    "%@ is waiting. Open Cassini to start.": {
      "comment": "Notification body: a note waits for the model download",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is waiting. Open Cassini to start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in attesa. Apri Cassini per iniziare."
          }
        }
      }
    },
    "%lld speakers · %@": {
      "comment": "Notification body: speakers and duration of a transcribed note",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld speaker · %@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld speakers · %@"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld voce · %@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld voci · %@"
                }
              }
            }
          }
        }
      }
    },
    "Cassini closed while transcribing %@.": {
      "comment": "Notification body: Cassini closed during a transcription",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini closed while transcribing %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini si è chiuso durante la trascrizione di %@."
          }
        }
      }
    },
    "Cassini needs a one-time download. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here.": {
      "comment": "Model download screen body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini needs a one-time download. After that, recognising words and telling voices apart happen on this device, even offline. Your audio stays here."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ha bisogno di un unico download. Dopo, il riconoscimento delle parole e la distinzione delle voci avvengono su questo dispositivo, anche offline. Il tuo audio resta qui."
          }
        }
      }
    },
    "Continue": {
      "comment": "Held queue banner action: start the queue again",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        }
      }
    },
    "Continue when you’re ready.": {
      "comment": "Held queue banner body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue when you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua quando vuoi."
          }
        }
      }
    },
    "Couldn’t transcribe %@": {
      "comment": "Notification title: a note could not be transcribed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t transcribe %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere %@"
          }
        }
      }
    },
    "Download": {
      "comment": "Model download button without a note",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica"
          }
        }
      }
    },
    "Download and transcribe": {
      "comment": "Model download button with a note waiting",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and transcribe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica e trascrivi"
          }
        }
      }
    },
    "Free about %@ and try again.": {
      "comment": "Banner body: the space to free",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free about %@ and try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera circa %@ e riprova."
          }
        }
      }
    },
    "Less than 200 MB free. The recording so far is saved.": {
      "comment": "Notification body: a recording stopped for lack of space",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 200 MB free. The recording so far is saved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno di 200 MB liberi. La registrazione fatta finora è salvata."
          }
        }
      }
    },
    "Microphone stopped working": {
      "comment": "Notification title: the microphone failed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone stopped working"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono ha smesso di funzionare"
          }
        }
      }
    },
    "Needs about %@ free while installing. Each file is checked before it is used.": {
      "comment": "Model download footnote with the free space the install needs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs about %@ free while installing. Each file is checked before it is used."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono circa %@ liberi durante l’installazione. Ogni file viene verificato prima dell’uso."
          }
        }
      }
    },
    "Not enough storage": {
      "comment": "Banner title: not enough free space for the models",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough storage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente"
          }
        }
      }
    },
    "Not now — keep the audio": {
      "comment": "Model download refusal",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now — keep the audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora — tieni l’audio"
          }
        }
      }
    },
    "Ready to transcribe": {
      "comment": "Notification title: a note waits for the model download",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to transcribe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronta da trascrivere"
          }
        }
      }
    },
    "Recognising saved voices": {
      "comment": "Model part",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognising saved voices"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento delle voci salvate"
          }
        }
      }
    },
    "Recording ended. The audio so far is in your library.": {
      "comment": "Notification body: the microphone failed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording ended. The audio so far is in your library."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione terminata. L’audio registrato finora è nella libreria."
          }
        }
      }
    },
    "Recording stopped": {
      "comment": "Notification title: a recording stopped for lack of space",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione interrotta"
          }
        }
      }
    },
    "Retry": {
      "comment": "Banner action",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        }
      }
    },
    "Speech recognition": {
      "comment": "Model part",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento vocale"
          }
        }
      }
    },
    "Telling speakers apart": {
      "comment": "Model part",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telling speakers apart"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinzione delle voci"
          }
        }
      }
    },
    "Transcribe on this device": {
      "comment": "Model download screen title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe on this device"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrivi su questo dispositivo"
          }
        }
      }
    },
    "Transcribed: %@": {
      "comment": "Notification title: a note was transcribed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribed: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascritta: %@"
          }
        }
      }
    },
    "Transcribing “%@”": {
      "comment": "The system's progress while a note is transcribed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing “%@”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione di “%@”"
          }
        }
      }
    },
    "Transcription paused by iOS": {
      "comment": "Notification title: iOS ended the background time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription paused by iOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione sospesa da iOS"
          }
        }
      }
    },
    "Transcription paused · %lld waiting": {
      "comment": "Held queue banner title with the notes waiting",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Transcription paused · %lld waiting"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Transcription paused · %lld waiting"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Trascrizione in pausa · %lld in attesa"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Trascrizione in pausa · %lld in attesa"
                }
              }
            }
          }
        }
      }
    },
    "Transcription stopped": {
      "comment": "Notification title: Cassini closed during a transcription",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription stopped"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione interrotta"
          }
        }
      }
    },
    "Where the models come from · Privacy": {
      "comment": "Model download link to the licenses",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the models come from · Privacy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da dove vengono i modelli · Privacy"
          }
        }
      }
    },
    "Your audio stays on this device": {
      "comment": "Subtitle of the system's progress while a note is transcribed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your audio stays on this device"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo audio resta su questo dispositivo"
          }
        }
      }
    },
    "iOS needed the time back. Open Cassini to resume.": {
      "comment": "Notification body: iOS ended the background time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS needed the time back. Open Cassini to resume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha ripreso il tempo in background. Apri Cassini per riprendere."
          }
        }
      }
    }
  },
  "version": "1.0"
}
