    "The transcription queue was saved by a newer version of Cassini, or can’t be read. Update Cassini to transcribe.": {
      "comment": "A Transcribe was refused: the stored queue cannot be used",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcription queue was saved by a newer version of Cassini, or can’t be read. Update Cassini to transcribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola de transcripción la guardó una versión más reciente de Cassini o no se puede leer. Actualiza Cassini para transcribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file de transcription a été sauvegardée par une version plus récente de Cassini, ou est illisible. Mettez à jour Cassini pour transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coda di trascrizione è stata salvata da una versione più recente di Cassini, o non si può leggere. Aggiorna Cassini per trascrivere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila de transcrição foi salva por uma versão mais recente do Cassini ou não pode ser lida. Atualize o Cassini para transcrever."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila de transcrição foi guardada por uma versão mais recente do Cassini ou não pode ser lida. Atualize o Cassini para transcrever."
          }
        }
      }
    },
    "This recording is still being saved. Try again in a moment.": {
      "comment": "A Transcribe was refused: the recording is still being written",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording is still being saved. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación aún se está guardando. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement est encore en cours de sauvegarde. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione è ancora in salvataggio. Riprova tra un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação ainda está sendo salva. Tente novamente em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação ainda está a ser guardada. Tente novamente daqui a pouco."
          }
        }
      }
    },
    "This recording no longer exists.": {
      "comment": "A Transcribe was refused: the note is gone",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording no longer exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación ya no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n’existe plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione non esiste più."
          }
        },
        "pt-BR": {
