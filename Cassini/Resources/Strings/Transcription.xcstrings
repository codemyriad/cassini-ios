    },
    "This recording was saved by a newer version of Cassini. Update Cassini to transcribe it.": {
      "comment": "A Transcribe was refused: the note's format is newer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording was saved by a newer version of Cassini. Update Cassini to transcribe it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación la guardó una versión más reciente de Cassini. Actualiza Cassini para transcribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement a été sauvegardé par une version plus récente de Cassini. Mettez à jour Cassini pour le transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione è stata salvata da una versione più recente di Cassini. Aggiorna Cassini per trascriverla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação foi salva por uma versão mais recente do Cassini. Atualize o Cassini para transcrevê-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação foi guardada por uma versão mais recente do Cassini. Atualize o Cassini para a transcrever."
          }
        }
      }
    },
