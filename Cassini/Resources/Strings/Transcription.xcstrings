    "Needs about %@ free while installing. Each file is checked before it is used.": {
      "comment": "Model download footnote with the free space the install needs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs about %@ free while installing. Each file is checked before it is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita unos %@ libres durante la instalación. Cada archivo se verifica antes de usarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite environ %@ d’espace libre pendant l’installation. Chaque fichier est vérifié avant utilisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono circa %@ liberi durante l’installazione. Ogni file viene verificato prima dell’uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de cerca de %@ livres durante a instalação. Cada arquivo é verificado antes de ser usado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de cerca de %@ livres durante a instalação. Cada ficheiro é verificado antes de ser usado."
          }
        }
      }
    },
    "Not now — keep the audio": {
      "comment": "Model download refusal",
      "localizations": {
