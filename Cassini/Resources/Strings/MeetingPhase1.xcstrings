    "speakers.rememberVoice.cardBody.iphone": {
      "comment": "Generated from cassini-ux 5e0c34e0f1bb390298dabdf4eedc494e933fd329, speakers.rememberVoice.cardBody.iphone; named placeholders stay verbatim.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} is named automatically next time.\nThe voiceprint stays on this iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima volta Cassini darà automaticamente il nome {name}.\nL’impronta vocale resta su questo iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini nommera {name} automatiquement la prochaine fois.\nL’empreinte vocale reste sur cet iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini pondrá el nombre {name} automáticamente la próxima vez.\nLa huella de voz se queda en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini dará o nome {name} automaticamente da próxima vez.\nA impressão de voz fica neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini dará o nome {name} automaticamente da próxima vez.\nA impressão vocal fica neste iPhone."
          }
        }
      }
    },
    "speakers.rememberVoice.cardBody.iphone.unnamed": {
      "comment": "Generated from cassini-ux 5e0c34e0f1bb390298dabdf4eedc494e933fd329, speakers.rememberVoice.cardBody.iphone.unnamed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person is named automatically next time.\nThe voiceprint stays on this iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima volta Cassini darà automaticamente un nome a questa persona.\nL’impronta vocale resta su questo iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini nommera cette personne automatiquement la prochaine fois.\nL’empreinte vocale reste sur cet iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini pondrá nombre a esta persona automáticamente la próxima vez.\nLa huella de voz se queda en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini dará nome a esta pessoa automaticamente da próxima vez.\nA impressão de voz fica neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini dará nome a esta pessoa automaticamente da próxima vez.\nA impressão vocal fica neste iPhone."
          }
        }
      }
    },
    "speakers.rememberVoice.modelsNeeded": {
      "comment": "Generated from cassini-ux 5e0c34e0f1bb390298dabdf4eedc494e933fd329, speakers.rememberVoice.modelsNeeded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To remember voices, download and turn on Tell speakers apart and Recognise saved voices in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricordare le voci, scarica e attiva “Distingui le voci” e “Riconosci le voci salvate” nelle impostazioni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour mémoriser des voix, téléchargez et activez « Distinguer les intervenants » et « Reconnaître les voix mémorisées » dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recordar voces, descarga y activa Distinguir hablantes y Reconocer voces guardadas en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lembrar vozes, baixe e ative Distinguir locutores e Reconhecer vozes salvas nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para memorizar vozes, transfira e ative Distinguir oradores e Reconhecer vozes guardadas nas definições."
          }
        }
      }
    },
