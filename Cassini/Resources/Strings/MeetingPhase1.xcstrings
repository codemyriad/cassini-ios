    "speakers.rememberVoice.tooShort": {
      "comment": "Generated from cassini-ux 5e0c34e0f1bb390298dabdf4eedc494e933fd329, speakers.rememberVoice.tooShort.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini needs at least 4 seconds of this voice to remember it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ha bisogno di almeno 4 secondi di questa voce per ricordarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini a besoin d’au moins 4 secondes de cette voix pour la mémoriser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini necesita al menos 4 segundos de esta voz para recordarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de pelo menos 4 segundos desta voz para lembrá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini precisa de, pelo menos, 4 segundos desta voz para a memorizar."
          }
        }
      }
    },
