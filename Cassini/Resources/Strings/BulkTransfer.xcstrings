{
  "sourceLanguage": "en",
  "strings": {
    "common.cancel": {
      "comment": "D96 shared catalog: Secondary grey button (Esc). Uses: confirmations 2 and 3 (UX2 gallery), the Export dialog (UX7a), the Speakers dialog footer (UX16) and a running model download (UX8b). On a download it cancels and the row goes back to Not downloaded. GNOME dialogs: equal width. Mac: natural width. Speakers footer: trailing, natural width on both platforms. Settings download row: small 32 px grey row button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "common.done": {
      "comment": "D96 shared catalog: Suggested/accent button that closes the dialog. CompanionSetup GNOME: equal width with Not now; Mac: trailing, natural width, default button. CompanionSetup draws it disabled grey while step 2 is pending; the enabled accent look is inferred, not drawn. WhatIsRecorded: UX11.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
        }
      }
    },
    "import.filter.cassiniAndZip": {
      "comment": "D96 shared catalog: Coordinator (D96). Name of the file-type filter in the import picker, where the platform's picker shows one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini files and ZIP archives"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File Cassini e archivi ZIP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers Cassini et archives ZIP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos Cassini y archivos ZIP"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos Cassini e arquivos ZIP"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros Cassini e ficheiros ZIP"
          }
        }
      }
    },
    "import.progress": {
      "comment": "D96 shared catalog: Coordinator (D96). Shown while an import of several files or of a ZIP archive runs. The cancel action is common.cancel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing %1$lld of %2$lld…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione %1$lld di %2$lld…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importation %1$lld sur %2$lld…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando %1$lld de %2$lld…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando %1$lld de %2$lld…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A importar %1$lld de %2$lld…"
          }
        }
      }
    },
    "import.cancelled": {
      "comment": "D96 shared catalog: Coordinator (D96). Shown when the person cancels a running import. What was already imported stays in the Library; the import.summary.* parts may follow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import cancelled"
