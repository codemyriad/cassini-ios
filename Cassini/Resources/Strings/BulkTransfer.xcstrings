    "import.zip.failed.damaged": {
      "comment": "D96 shared catalog: Coordinator (D96). The archive cannot be read as a ZIP (no or broken directory). A single damaged entry is counted in import.summary.failed instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ZIP archive is damaged and can’t be opened."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio ZIP è danneggiato e non può essere aperto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ZIP est endommagée et ne peut pas être ouverte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ZIP está dañado y no se puede abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo ZIP está danificado e não pode ser aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro ZIP está danificado e não pode ser aberto."
          }
        }
      }
    },
    "import.zip.failed.encrypted": {
      "comment": "D96 shared catalog: Coordinator (D96). Any encrypted entry refuses the whole archive. Cassini never asks for the password.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ZIP archive is password-protected. Cassini can’t open password-protected archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio ZIP è protetto da password. Cassini non può aprire gli archivi protetti da password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ZIP est protégée par un mot de passe. Cassini ne peut pas ouvrir les archives protégées par un mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ZIP está protegido con contraseña. Cassini no puede abrir archivos ZIP protegidos con contraseña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo ZIP está protegido por senha. O Cassini não pode abrir arquivos ZIP protegidos por senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro ZIP está protegido por palavra-passe. O Cassini não pode abrir ficheiros ZIP protegidos por palavra-passe."
          }
        }
      }
    },
    "import.zip.failed.unsafePaths": {
      "comment": "D96 shared catalog: Coordinator (D96). An entry path is absolute or contains '..'. The archive is refused as a whole, before anything is imported.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ZIP archive contains unsafe file paths. Nothing was imported."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio ZIP contiene percorsi di file non sicuri. Non è stato importato nulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ZIP contient des chemins de fichiers non sûrs. Rien n’a été importé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ZIP contiene rutas de archivo no seguras. No se importó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo ZIP contém caminhos de arquivo não seguros. Nada foi importado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro ZIP contém caminhos de ficheiro não seguros. Nada foi importado."
          }
        }
      }
    },
    "import.zip.failed.tooLarge": {
      "comment": "D96 shared catalog: Coordinator (D96). An archive limit of D96 is exceeded: more than 2,000 entries, more than 20 GB uncompressed, or a compressed entry above 100:1. The numbers are not shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ZIP archive is too large to import."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio ZIP è troppo grande per essere importato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ZIP est trop volumineuse pour être importée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ZIP es demasiado grande para importarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
