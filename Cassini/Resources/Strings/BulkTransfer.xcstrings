    "import.summary.imported": {
      "comment": "D96 shared catalog: Coordinator (D96). Import summary part: items added to the Library. The summary shows only the parts whose count is not 0, joined the way the app joins such parts (e.g. ' · ' or one per line). No noun on purpose: the wording must read correctly whatever the app calls the item; participles agree in the feminine, which fits it in every language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Imported %lld"
                }
              },
