    "Saved voices could not be read, so nothing was deleted. Their files are kept.": {
      "comment": "Delete now or Empty while the saved voices cannot be read",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voices could not be read, so nothing was deleted. Their files are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las voces guardadas, así que no se eliminó nada. Sus archivos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les voix mémorisées, donc rien n’a été supprimé. Leurs fichiers sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le voci salvate, quindi non è stato eliminato nulla. I loro file sono conservati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as vozes salvas, então nada foi excluído. Os arquivos delas foram mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as vozes guardadas, por isso nada foi eliminado. Os ficheiros são mantidos."
          }
        }
      }
    },
