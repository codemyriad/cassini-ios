          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days left"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
