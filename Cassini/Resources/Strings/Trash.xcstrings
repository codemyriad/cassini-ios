    "Notes here are deleted for good after 30 days, with their audio, transcripts and voiceprints from those notes.": {
      "comment": "Recently Deleted intro",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes here are deleted for good after 30 days, with their audio, transcripts and voiceprints from those notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de aquí se eliminan para siempre tras 30 días, junto con su audio, sus transcripciones y las huellas de voz de esas notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes présentes ici sont supprimées définitivement après 30 jours, avec leur audio, leurs transcriptions et leurs empreintes vocales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note qui vengono eliminate per sempre dopo 30 giorni, con il loro audio, le trascrizioni e le impronte vocali di quelle note."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas aqui são excluídas para sempre após 30 dias, com o áudio, as transcrições e as impressões de voz delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas aqui são eliminadas definitivamente após 30 dias, com o respetivo áudio, transcrições e impressões vocais."
          }
        }
      }
    },
