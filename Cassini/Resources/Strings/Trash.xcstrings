    "Its audio, transcripts and voiceprints from this note are deleted. This can’t be undone.": {
      "comment": "Delete now confirmation body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its audio, transcripts and voiceprints from this note are deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán su audio, sus transcripciones y las huellas de voz de esta nota. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son audio, ses transcriptions et les empreintes vocales de cette note sont supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio, le trascrizioni e le impronte vocali di questa nota vengono eliminati. Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio, as transcrições e as impressões de voz desta nota serão excluídos. Não é possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio, as transcrições e as impressões vocais desta nota são eliminados. Não é possível desfazer."
          }
        }
      }
    },
