            "value": "Las copias de seguridad siguen tus ajustes de iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups seguem os seus ajustes do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias de segurança seguem as suas definições de iCloud."
          }
        }
      }
    },
