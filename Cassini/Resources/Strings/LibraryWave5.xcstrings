    "firstRun.privacy.backups.ios": {
      "comment": "Generated from cassini-ux 160fb923944422c5c4ff01aa777bb572e2a6e96e, firstRun.privacy.backups.ios.",
      "extractionState": "manual",
      "localizations": {
