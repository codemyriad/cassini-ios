    "privacy.onDevice.ipad.backupExcluded": {
      "comment": "Generated from cassini-ux 160fb923944422c5c4ff01aa777bb572e2a6e96e, privacy.onDevice.ipad.backupExcluded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribed on this iPad. Cassini never uploads the audio and marks it to be left out of iCloud Backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascritto su questo iPad. Cassini non carica mai l’audio e lo contrassegna per escluderlo dal Backup iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit sur cet iPad. Cassini ne met jamais l’audio en ligne et le marque pour l’exclure de la Sauvegarde iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito en este iPad. Cassini nunca sube el audio y lo marca para dejarlo fuera de Copia en iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. O Cassini nunca envia o áudio e o marca para ficar fora do Backup do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. O Cassini nunca envia o áudio e marca-o para ficar fora da Cópia em iCloud."
          }
        }
      }
    },
    "privacy.onDevice.ipad.withBackup": {
      "comment": "Generated from cassini-ux 160fb923944422c5c4ff01aa777bb572e2a6e96e, privacy.onDevice.ipad.withBackup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribed on this iPad. Never uploaded, except to your encrypted cloud backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascritto su questo iPad. Mai caricato, tranne nel tuo backup crittografato nel cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit sur cet iPad. Jamais mis en ligne, sauf dans votre sauvegarde cloud chiffrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito en este iPad. Nunca se sube, salvo a tu copia de seguridad cifrada en la nube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. Nunca é enviado, exceto para o seu backup criptografado na nuvem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. Nunca é enviado, exceto para a sua cópia de segurança encriptada na nuvem."
          }
        }
      }
    },
