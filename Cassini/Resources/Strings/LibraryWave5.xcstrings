    "privacy.onDevice.ipad.backupExcluded": {
      "comment": "Generated from cassini-ux 1ffebfa94d02ec966a048d8dded567ce29106702, privacy.onDevice.ipad.backupExcluded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written down on this iPad. Cassini never uploads the audio and marks it to be left out of iCloud Backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascritto su questo iPad. Cassini non carica mai l’audio e lo contrassegna per escluderlo dal Backup iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit sur cet iPad. Cassini ne met jamais l’audio en ligne et le marque pour l’exclure de Sauvegarde iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito en este iPad. Cassini nunca sube el audio y lo marca para dejarlo fuera de Copia en iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. O Cassini nunca envia o áudio e o marca para ficar fora do Backup do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito neste iPad. O Cassini nunca envia o áudio e marca-o para ficar fora da Cópia em iCloud."
          }
        }
      }
    },
    "privacy.onDevice.ipad.withBackup": {
      "comment": "Generated from cassini-ux 1ffebfa94d02ec966a048d8dded567ce29106702, privacy.onDevice.ipad.withBackup.",
