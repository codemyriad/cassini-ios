        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup seguono le impostazioni di iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes suivent vos réglages iCloud."
