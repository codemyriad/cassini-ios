    "iOS ended the time Cassini had in the background. Resume to continue where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended the time Cassini had in the background. Resume to continue where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS terminó el tiempo que Cassini tenía en segundo plano. Reanuda para continuar donde se detuvo."
