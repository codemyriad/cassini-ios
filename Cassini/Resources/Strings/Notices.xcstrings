        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a mis fin au temps accordé à Cassini en arrière-plan. Reprenez pour continuer là où la transcription s’est arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
