    "Managed by iOS": {
      "comment": "Model row subtitle: Apple's speech assets have no size before they are downloaded",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed by iOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestito da iOS"
          }
        }
