    "Matches can be wrong; check the names. Only voices you save are used to recognise people.": {
      "comment": "Speakers footer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches can be wrong; check the names. Only voices you save are used to recognise people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las coincidencias pueden fallar: revisa los nombres. Solo las voces que guardas se usan para reconocer a las personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les correspondances peuvent être erronées ; vérifiez les noms. Seules les voix que vous mémorisez servent à reconnaître les personnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corrispondenze possono sbagliare: controlla i nomi. Solo le voci che salvi servono a riconoscere le persone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As correspondências podem estar erradas; confira os nomes. Só as vozes que você salva são usadas para reconhecer pessoas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As correspondências podem estar erradas: verifique os nomes. Só as vozes que guardar são usadas para reconhecer pessoas."
