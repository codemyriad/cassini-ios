        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua este trecho a um locutor. Renomeie ou mescle pessoas em Locutores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua este trecho a um orador. Mude o nome ou junte pessoas em Oradores."
