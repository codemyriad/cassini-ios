          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna este fragmento a un hablante. Renombra o fusiona personas desde Hablantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez ce passage à un intervenant. Renommez ou fusionnez des personnes depuis Intervenants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna questo passaggio a una voce. Rinomina o unisci le persone da Voci."
