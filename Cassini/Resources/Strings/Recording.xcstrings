    "Cassini closed unexpectedly. We saved what was captured (%@).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini closed unexpectedly. We saved what was captured (%@)."
