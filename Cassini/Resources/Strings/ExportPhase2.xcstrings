      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transcript yet, so only the audio can be exported."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora una trascrizione, quindi si può esportare solo l’audio."
