    "export.audioOnly.note": {
      "comment": "Generated from cassini-ux 277c65423909ec6f696836eeefede6d4ac5e4c84, export.audioOnly.note.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transcript yet, so only the audio can be exported."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora una trascrizione, quindi si può esportare solo l’audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de transcription, seul l’audio peut être exporté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay transcripción, así que solo se puede exportar el audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há transcrição, então só é possível exportar o áudio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há transcrição, por isso só é possível exportar o áudio."
          }
        }
      }
    },
    "export.cassiniFile.description": {
      "comment": "Generated from cassini-ux 277c65423909ec6f696836eeefede6d4ac5e4c84, export.cassiniFile.description.",
      "extractionState": "manual",
      "localizations": {
