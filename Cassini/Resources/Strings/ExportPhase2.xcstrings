            "state": "translated",
            "value": "Audio con la trascrizione dentro. Si riproduce in qualsiasi lettore audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio avec la transcription intégrée. Se lit dans n’importe quel lecteur audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio con la transcripción dentro. Se reproduce en cualquier reproductor de audio."
