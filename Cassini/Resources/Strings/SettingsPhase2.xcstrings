    "savedVoices.privacy.phone": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, savedVoices.privacy.phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints are created on this phone and are never written into exported or shared files. Only the names you choose are."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impronte vocali vengono create su questo telefono e non vengono mai scritte nei file esportati o condivisi. Vengono inclusi solo i nomi che scegli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes vocales sont créées sur ce téléphone et ne sont jamais écrites dans les fichiers exportés ou partagés. Seuls les noms que vous choisissez y figurent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las huellas de voz se crean en este teléfono y nunca se incluyen en los archivos exportados o compartidos. Solo se incluyen los nombres que eliges."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões de voz são criadas neste celular e nunca são incluídas em arquivos exportados ou compartilhados. Só os nomes que você escolhe são incluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões vocais são criadas neste telemóvel e nunca são incluídas nos ficheiros exportados ou partilhados. Só os nomes que escolher são incluídos."
          }
        }
      }
    },
