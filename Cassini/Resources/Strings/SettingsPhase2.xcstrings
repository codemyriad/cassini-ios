    "about.tagline.ipad": {
      "comment": "Generated from cassini-ux 1ffebfa94d02ec966a048d8dded567ce29106702, about.tagline.ipad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns speech into searchable, timed text, right here on your iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il parlato in testo ricercabile e con i tempi, proprio qui sul tuo iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme la parole en texte horodaté et consultable, ici même sur votre iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte la voz en texto con tiempos en el que puedes buscar, aquí mismo en tu iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma a fala em texto pesquisável e com marcação de tempo, aqui mesmo no seu iPad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma a fala em texto pesquisável e com marcação de tempo, aqui mesmo no seu iPad."
          }
        }
      }
    },
