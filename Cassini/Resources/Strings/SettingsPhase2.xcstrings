    "about.tagline.ipad": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, about.tagline.ipad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns speech into searchable, timed text, right here on your iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il parlato in testo ricercabile con riferimenti temporali, proprio qui sul tuo iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme la parole en texte horodaté et consultable, ici même sur votre iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte la voz en texto con marcas de tiempo en el que puedes buscar, aquí mismo en tu iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma a fala em texto pesquisável e com marcação de tempo, aqui mesmo no seu iPad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma a fala em texto pesquisável e com marcação de tempo, aqui mesmo no seu iPad."
          }
        }
      }
    },
