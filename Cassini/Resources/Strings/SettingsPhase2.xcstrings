    "settings.phone.transcription.rightAway.subtitle": {
      "comment": "Generated from cassini-ux 1ffebfa94d02ec966a048d8dded567ce29106702, settings.phone.transcription.rightAway.subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, Cassini keeps the audio and you choose when to transcribe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è disattivato, Cassini conserva l’audio e scegli tu quando trascrivere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cette option est désactivée, Cassini garde l’audio et vous choisissez quand transcrire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, Cassini guarda el audio y tú eliges cuándo transcribir."
