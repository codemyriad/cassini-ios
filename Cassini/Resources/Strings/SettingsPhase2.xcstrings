    "backup.savedVoices.switch.description.ipad": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, backup.savedVoices.switch.description.ipad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints of people you’ve named, so a new or restored iPad keeps recognising them. A voice belongs to someone else, so this is its own choice."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impronte vocali delle persone a cui hai dato un nome, così un iPad nuovo o ripristinato continua a riconoscerle. Una voce appartiene a qualcun altro, quindi è una scelta a parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les empreintes vocales des personnes que vous avez nommées, pour qu’un iPad neuf ou restauré continue à les reconnaître. Une voix appartient à quelqu’un d’autre, c’est donc un choix à part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las huellas de voz de las personas a las que has puesto nombre, para que un iPad nuevo o restaurado las siga reconociendo. Una voz es de otra persona, así que es una decisión aparte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões de voz das pessoas que você nomeou, para que um iPad novo ou restaurado continue a reconhecê-las. Uma voz pertence a outra pessoa, então esta é uma escolha à parte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões de voz das pessoas a quem deu nome, para que um iPad novo ou restaurado continue a reconhecê-las. Uma voz pertence a outra pessoa, por isso esta é uma escolha à parte."
          }
        }
      }
    },
