    "backup.info.cassiniNever": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, backup.info.cassiniNever.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini itself never uploads or reads your meetings."
          }
