    "settings.phone.transcription.online": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, settings.phone.transcription.online.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini goes online only to download a model you ask for. Each file is checked before it is used."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini si connette a Internet solo per scaricare un modello che hai chiesto. Ogni file viene verificato prima dell’uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini ne se connecte à Internet que pour télécharger un modèle que vous avez demandé. Chaque fichier est vérifié avant d’être utilisé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini solo se conecta a internet para descargar un modelo que hayas pedido. Cada archivo se comprueba antes de usarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini só se conecta à internet para baixar um modelo que você pedir. Cada arquivo é verificado antes de ser usado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cassini só se liga à internet para transferir um modelo que pedir. Cada ficheiro é verificado antes de ser usado."
          }
        }
      }
    },
