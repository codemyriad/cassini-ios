    "backup.notice.body.ipad": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, backup.notice.body.ipad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud Backup is on, your meetings and saved voices go into it, so a new iPad gets them back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il backup di iCloud è attivo, le riunioni e le voci salvate ci finiscono dentro, così un nuovo iPad le recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la sauvegarde iCloud est activée, vos réunions et voix mémorisées y sont incluses, et un nouvel iPad les récupère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la copia de seguridad de iCloud está activada, tus reuniones y voces guardadas van en ella, y un iPad nuevo las recupera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Backup do iCloud estiver ativado, suas reuniões e vozes salvas vão para ele, e um iPad novo as recupera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a cópia de segurança do iCloud estiver ativada, as reuniões e vozes guardadas vão para ela, e um iPad novo recupera-as."
          }
        }
      }
    },
