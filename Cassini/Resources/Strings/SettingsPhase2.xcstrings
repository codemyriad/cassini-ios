    "settings.phone.speakers.autoName.subtitle": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, settings.phone.speakers.autoName.subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when Cassini is sure. Matches can be wrong, so this is off by default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quando Cassini è sicuro. Le corrispondenze possono essere sbagliate, quindi è disattivato per impostazione predefinita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand Cassini est sûr. Les correspondances peuvent être fausses, c’est donc désactivé par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando Cassini está seguro. Las coincidencias pueden fallar, así que está desactivado de forma predeterminada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando o Cassini tem certeza. As correspondências podem estar erradas, por isso vem desativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando o Cassini tem a certeza. As correspondências podem estar erradas, por isso vem desativado."
          }
        }
      }
    },
