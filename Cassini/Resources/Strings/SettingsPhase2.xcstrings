    "voices.setup.body.phone": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, voices.setup.body.phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you name a speaker, Cassini can remember their voice and name them for you in later meetings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai un nome a una voce, Cassini può ricordarla e dare il nome a quella persona nelle riunioni successive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous nommez un intervenant, Cassini peut mémoriser sa voix et le nommer pour vous dans les réunions suivantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pones nombre a un hablante, Cassini puede recordar su voz y ponerle nombre por ti en reuniones posteriores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você dá nome a um locutor, o Cassini pode lembrar a voz dele e dar o nome por você nas próximas reuniões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dá nome a um orador, o Cassini pode memorizar a voz e dar-lhe nome por si nas reuniões seguintes."
          }
        }
      }
    },
    "voices.setup.changeLater.phone": {
