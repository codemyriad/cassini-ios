    "savedVoices.howToAdd.short": {
      "comment": "Generated from cassini-ux e709094d283434fa59428544e0065e8deb49967b, savedVoices.howToAdd.short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add someone, name a speaker in a meeting and keep “Remember this voice” on. Forgetting a voice keeps the names already in your meetings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere qualcuno, dai un nome a una voce in una riunione e lascia attivo “Ricorda questa voce”. Se dimentichi una voce, i nomi già presenti nelle tue riunioni restano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter quelqu’un, nommez un intervenant dans une réunion et laissez « Mémoriser cette voix » activé. Si vous oubliez une voix, les noms déjà présents dans vos réunions sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir a alguien, pon nombre a un hablante en una reunión y deja activado “Recordar esta voz”. Si olvidas una voz, los nombres que ya están en tus reuniones se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um locutor em uma reunião e deixe “Lembrar esta voz” ativado. Esquecer uma voz mantém os nomes que já estão nas suas reuniões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar alguém, dê nome a um orador numa reunião e deixe «Memorizar esta voz» ativado. Esquecer uma voz mantém os nomes que já estão nas suas reuniões."
          }
        }
      }
    },
