    "NSMicrophoneUsageDescription": {
      "comment": "The microphone permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini uses the microphone to save recordings on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini usa el micrófono para guardar grabaciones en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini utilise le microphone pour créer des enregistrements sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassini usa il microfono per salvare le registrazioni sul tuo dispositivo."
          }
        },
        "pt-BR": {
