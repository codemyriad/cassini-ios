.DS_Store
.build/
# DerivedData is a link to DerivedData.noindex, which Spotlight skips.
DerivedData
DerivedData.noindex/
*.xcuserstate
xcuserdata/
.build-logs/

.swiftpm/
*.xcodeproj/
*.opus
# The cross-app vectors (coordination ux-draft/cross-app-vectors) are test inputs, pinned by their SHA-256.
!Packages/*/Tests/*/Resources/cross-app-vectors/*.opus
*.wav
*.caf
*.m4a
Models/
# Model weights stay out; the model code of the packages (CassiniEngine/Models) does not.
!Packages/*/Sources/*/Models/
!Packages/*/Tests/*/Models/
# ...so weights are ignored by name wherever they land.
*.onnx
*.onnx.zst
*.part
/.test-cache/
# Screenshots in the other languages (scripts/screenshots.sh --locale it|fr|es|pt-BR|pt-PT) are for review, not committed.
docs/screenshots/it/
docs/screenshots/fr/
docs/screenshots/es/
docs/screenshots/pt-BR/
docs/screenshots/pt-PT/
# The native runtime build (scripts/build-sherpa-xcframework.sh) and its downloads; also a link to another checkout's.
.tools
# Archives and exported .ipa files (docs/distribution.md).
/build/
