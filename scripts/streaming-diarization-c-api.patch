+/**
+ * @brief Sortformer-only incremental mode: diarize one chunk of a recording.
+ *
+ * The diarizer keeps its bounded speaker cache across calls, so speaker IDs
+ * stay the same from chunk to chunk. Segment times use the chunk's own clock.
+ * A new diarizer starts a new recording. Other models diarize the chunk alone.
+ *
+ * @return A newly allocated diarization result. Free it with
+ *         SherpaOnnxOfflineSpeakerDiarizationDestroyResult().
+ */
+SHERPA_ONNX_API const SherpaOnnxOfflineSpeakerDiarizationResult *
+SherpaOnnxOfflineSpeakerDiarizationProcessStreamingChunk(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, const float *samples,
+    int32_t n);
 
+/**
+ * @brief Save the incremental mode's speaker cache.
+ *
+ * @param n Receives the number of floats; 0 when there is no state yet.
+ * @return A newly allocated array of *n floats. Free it with
+ *         SherpaOnnxOfflineSpeakerDiarizationDestroyStreamingState().
+ */
+SHERPA_ONNX_API const float *
+SherpaOnnxOfflineSpeakerDiarizationSaveStreamingState(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, int32_t *n);
+
+/** @brief Free an array from SherpaOnnxOfflineSpeakerDiarizationSaveStreamingState(). */
+SHERPA_ONNX_API void SherpaOnnxOfflineSpeakerDiarizationDestroyStreamingState(
+    const float *state);
+
+/**
+ * @brief Restore a speaker cache saved by
+ * SherpaOnnxOfflineSpeakerDiarizationSaveStreamingState().
+ *
+ * @return 1 on success; 0 when the state does not fit this model, is longer
+ *         than 200000 floats, or the model is not Sortformer.
+ */
+SHERPA_ONNX_API int32_t SherpaOnnxOfflineSpeakerDiarizationRestoreStreamingState(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, const float *state,
+    int32_t n);
