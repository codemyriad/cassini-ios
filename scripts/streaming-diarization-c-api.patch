+const SherpaOnnxOfflineSpeakerDiarizationResult *
+SherpaOnnxOfflineSpeakerDiarizationProcessStreamingChunk(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, const float *samples,
+    int32_t n) {
+  auto ans = new SherpaOnnxOfflineSpeakerDiarizationResult;
+  ans->impl = sd->impl->ProcessStreamingChunk(samples, n);
 
   return ans;
+}
+
+const float *SherpaOnnxOfflineSpeakerDiarizationSaveStreamingState(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, int32_t *n) {
+  auto v = sd->impl->SaveStreamingState();
+  auto ans = new float[v.size() + 1];
+  std::copy(v.begin(), v.end(), ans);
+  *n = static_cast<int32_t>(v.size());
+
+  return ans;
+}
+
+void SherpaOnnxOfflineSpeakerDiarizationDestroyStreamingState(
+    const float *state) {
+  delete[] state;
+}
+
+int32_t SherpaOnnxOfflineSpeakerDiarizationRestoreStreamingState(
+    const SherpaOnnxOfflineSpeakerDiarization *sd, const float *state,
+    int32_t n) {
+  // The same bound as the JNI's restoreStreamingState.
+  if (n < 0 || n > 200000 || (n > 0 && !state)) return 0;
+  std::vector<float> v(state, state + n);
+
+  return sd->impl->RestoreStreamingState(v) ? 1 : 0;
 }
